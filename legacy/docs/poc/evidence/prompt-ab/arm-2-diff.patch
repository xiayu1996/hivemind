+// Coupons are applied in their supplied order, so percentage coupons can stack.
+// A percentage coupon uses a decimal rate (for example, 0.1 for 10%).
+export function applyCoupon(amount, coupons) {
+  const stack = Array.isArray(coupons) ? coupons : [coupons];
+
+  return stack.reduce((remaining, coupon) => {
+    if (coupon.type === "percentage") {
+      return remaining - remaining * coupon.value;
+    }
+
+    if (coupon.type === "flat") {
+      return remaining - coupon.value;
+    }
+
+    throw new TypeError(`Unsupported coupon type: ${coupon.type}`);
+  }, amount);
+}
