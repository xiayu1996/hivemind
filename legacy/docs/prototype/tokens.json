{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "$type": "color",
    "page": { "$value": "#f4f7fa" },
    "surface": { "$value": "#ffffff" },
    "text": { "$value": "#172b3a" },
    "text-muted": { "$value": "#526477" },
    "border": { "$value": "#cbd5df" },
    "action": { "$value": "#173f63" },
    "attention": { "$value": "#a75b00" },
    "danger": { "$value": "#b42318" },
    "success": { "$value": "#18794e" },
    "focus": { "$value": "#0b6bcb" },
    "surface-attention": { "$value": "#fff4df" },
    "surface-danger": { "$value": "#fff0ef" },
    "surface-success": { "$value": "#eaf7f0" },
    "surface-selected": { "$value": "#e9f1f8" }
  },
  "space": {
    "$type": "dimension",
    "inline-tight": { "$value": { "value": 4, "unit": "px" } },
    "control-gap": { "$value": { "value": 8, "unit": "px" } },
    "content-gap": { "$value": { "value": 12, "unit": "px" } },
    "section-gap": { "$value": { "value": 20, "unit": "px" } },
    "page-gutter": { "$value": { "value": 28, "unit": "px" } },
    "page-gutter-mobile": { "$value": { "value": 16, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "interface": { "$value": ["IBM Plex Sans", "Segoe UI", "sans-serif"] },
      "numeric": { "$value": ["IBM Plex Mono", "SFMono-Regular", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "caption": { "$value": { "value": 12, "unit": "px" } },
      "body": { "$value": { "value": 14, "unit": "px" } },
      "body-large": { "$value": { "value": 16, "unit": "px" } },
      "heading-small": { "$value": { "value": 18, "unit": "px" } },
      "heading-page": { "$value": { "value": 26, "unit": "px" } },
      "metric": { "$value": { "value": 30, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 550 },
      "strong": { "$value": 700 }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 6, "unit": "px" } },
    "panel": { "$value": { "value": 10, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "color": "#172b3a14",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 8, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "layer": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 10 },
    "navigation": { "$value": 20 }
  }
}
