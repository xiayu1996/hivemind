{
  "name": "hivemind",
  "version": "0.2.0",
  "private": true,
  "description": "Autonomous coding agent service: takes a requirement from a board, builds it on an integration branch item by item, and has an independent evaluator accept each item in a real browser before it lands.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "hivemind": "node src/main.ts",
    "start": "node src/main.ts run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit generate && git diff --exit-code -- drizzle && test -z \"$(git ls-files --others --exclude-standard -- drizzle)\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.45.2",
    "playwright": "1.63.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "^1.24.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
